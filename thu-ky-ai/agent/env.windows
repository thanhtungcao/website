# Cấu hình Thư Ký AI. Dòng bắt đầu bằng # là ghi chú.
# Dán khóa Claude API sau dấu bằng (lấy tại https://console.anthropic.com):
ANTHROPIC_API_KEY=

# Độ chính xác chép lời: small (nhanh) hoặc medium (chính xác hơn)
ASR_MODEL=small

# Tên riêng, thuật ngữ luôn cần viết đúng, cách nhau bằng dấu phẩy
GLOSSARY=

# Số ngày giữ biên bản trên máy
RETENTION_DAYS=30

# Bot vào họp: 1 = ẩn cửa sổ bot, 0 = hiện cửa sổ để bấm giúp khi cần
BOT_HEADLESS=0
